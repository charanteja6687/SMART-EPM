            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart EPM Rollout\",\n  \"description\": \"Internal rollout project\",\n  \"status\": \"ACTIVE\",\n  \"priority\": \"HIGH\",\n  \"startDate\": \"2026-07-01\",\n  \"deadline\": \"2026-09-30\",\n  \"employeeIds\": [1, 2]\n}"
            },
            "url": "{{baseUrl}}/projects"
          }
        },
