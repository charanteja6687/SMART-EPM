            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart EPM Rollout\",\n  \"description\": \"Updated description\",\n  \"status\": \"ACTIVE\",\n  \"priority\": \"MEDIUM\",\n  \"startDate\": \"2026-07-01\",\n  \"deadline\": \"2026-10-15\",\n  \"employeeIds\": [1]\n}"
            },
            "url": "{{baseUrl}}/projects/1"
          }
        },
        {
          "name": "Assign Employees",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[1, 2, 3]"
            },
            "url": "{{baseUrl}}/projects/1/assign-employees"
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/projects/1"
          }
        },
        {
          "name": "Get Deleted Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/projects/deleted"
          }
        },
        {
          "name": "Restore Project",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/projects/1/restore"
          }
        }
      ]
    },
    {
